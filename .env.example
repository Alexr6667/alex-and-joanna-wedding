# Local development uses the Neon `development` branch. Never put production values here.
#
#   neon link --project-id wild-cloud-37283675 --branch development -y
#
# writes the Neon-managed variables below into .env.local (gitignored). Add the
# two app-managed variables at the bottom yourself; `neon env pull` leaves them alone.
# Never commit .env.local or any file containing real values.

# --- Neon-managed (written by neon link / neon env pull) ---

# Pooled connection string. Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string. Used only for migrations (see README "Database migrations").
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example-123456.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Neon Auth URL for the same branch as DATABASE_URL.
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.eu-west-2.aws.neon.tech/neondb/auth
# Also written by Neon, not read by the app: NEON_BRANCH, NEON_AUTH_JWKS_URL.

# --- App-managed (required, set by hand) ---

# Signs the session cache cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32

# Comma-separated emails allowed into /admin. Case-insensitive.
ADMIN_EMAILS=first@example.com,second@example.com
