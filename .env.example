# Copy to .env.local for local development: cp .env.example .env.local
# Never commit .env.local or any file containing real values.
# All four variables are required. The app refuses to start without them.

# Neon Postgres connection string (Neon Console > Connect).
# Use the pooled string for the app. For migrations Neon recommends the direct
# (non-pooled) string; see README "Database migrations".
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth URL for the same branch (Neon Console > Auth > Configuration).
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# Signs the session cache cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32

# Comma-separated emails allowed into /admin. Case-insensitive.
ADMIN_EMAILS=first@example.com,second@example.com
